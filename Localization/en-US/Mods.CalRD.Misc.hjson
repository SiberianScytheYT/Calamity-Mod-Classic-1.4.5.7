HeatProtection: Provides heat protection in Death Mode
ColdProtection: Provides cold protection in Death Mode
HeatColdProtection: Provides heat and cold protection in Death Mode
RevDrop: Revengeance drop
RogueDamageLine: "{0} rogue {1}"
Charge: Current Charge: {0}%
TrueMeleeDamage: " true melee damage"
NoAbyss: Cannot be used in the Abyss
SmallLightAbyss: Provides a small amount of light in the abyss
ModerateLightAbyss: Provides a moderate amount of light in the abyss
LargeLightAbyss: Provides a large amount of light in the abyss
ModerateBreathLoss: Moderately reduces breath loss in the abyss
LargeBreathLoss: Greatly reduces breath loss in the abyss
TenPercentTrueMelee: 10% increased true melee damage

RecipeGroup: {
	AnyEvilBlock: Any Evil Block
	AnyEvilBar: Any Evil Bar
	AnyEvilPowder: Any Evil Powder
	NForEE: Nightmare Fuel or Endothermic Energy
	Boss2Material: Shadow Scale or Tissue Sample
	CursedFlameIchor: Cursed Flame or Ichor
	AnyEvilFlask: Any Evil Flask
	AnyEvilWater: Any Evil Water
	HardmodeAnvil: Any Hardmode Anvil
	HardmodeForge: Any Hardmode Forge
	LunarPickaxe: Any Lunar Pickaxe
	LunarHamaxe: Any Lunar Hamaxe
	AnyFood: Any Food Item
	WingsGroup: Any Wings
}

Fargos: {
	SunkenSeaFountain: Forces surrounding biome state to Sunken Sea upon activation
	SulphurousFountain: Forces surrounding biome state to Sulphurous Sea upon activation
	AstralFountain: Forces surrounding biome state to Astral upon activation
}

