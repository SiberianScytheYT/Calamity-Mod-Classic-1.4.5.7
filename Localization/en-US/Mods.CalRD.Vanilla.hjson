BuffDescription: {
	WeaponImbueRogue: "Rogue and "
	WeaponImbueConfetti: All attacks cause confetti to appear
	ChaosState: Rod of Discord teleports are disabled
	CursedInfernoExtra: All damage taken increased by 20%
	WarmthExtra: Immunity to the Chilled, Frozen, and Glacial State debuffs
	InvisibilityExtra: Grants rogue bonuses while holding certain rogue weapons
	Daybreak: Incinerated by solar rays
}

ItemTooltips: {
	WarmthExtra: Makes you immune to the Chilled, Frozen, and Glacial State debuffs
	BottledHoneyExtra: Grants the Honey buff for 2 minutes
	RodofDiscordExtra: Teleportation is disabled while Chaos State is active
	FlaskofVenom: Melee and rogue attacks inflict Venom on enemies
	FlaskofCursedFlames: Melee and rogue attacks inflict enemies with cursed flames
	FlaskofFire: Melee and rogue attacks set enemies on fire
	FlaskofGold: Melee and rogue attacks make enemies drop more gold
	FlaskofIchor: Melee and rogue attacks decrease enemy defense
	FlaskofNanites: Melee and rogue attacks confuse enemies
	FlaskofPoison: Melee and rogue attacks poison enemies
	SpectreHood: 20% decreased magic damage
	ObsidianSkin:
		'''
		Provides immunity to direct damage from touching lava
		Provides temporary immunity to lava burn damage
		Greatly increases lava immunity time regeneration
		Reduces lava burn damage
		'''
	ObsidianRose:
		'''
		Reduced direct damage from touching lava
		Greatly reduces lava burn damage
		'''
	InvisibilityPotionExtra: Boosts certain stats when holding certain types of rogue weapons
	GoldenFishingRod:
		'''
		Requires bait to catch fish
		The line will never break
		'''
	Picksaw: Capable of mining Lihzahrd Bricks and Scoria Ore
	MineUelibloom:
		'''
		Material
		Can mine Uelibloom Ore
		'''

	SetBonus: {
		Meteor: Set Bonus: Reduces the mana cost of the Space Gun by 50%
		Copper: Set Bonus: +2 defense and 15% increased mining speed
		Tin: Set Bonus: +2 defense and 10% increased mining speed
		AncientIron: Set Bonus: +2 defense and 25% increased mining speed
		Lead: Set Bonus: +3 defense and 20% increased mining speed
		Silver: Set Bonus: +3 defense and 35% increased mining speed
		Tungsten: Set Bonus: +3 defense and 30% increased mining speed
		AncientGold: Set Bonus: +3 defense and 45% increased mining speed
		Platinum: Set Bonus: +4 defense and 40% increased mining speed
		Forbidden: The minion damage nerf is reduced while wielding magic weapons
		Molten:
			'''
			17% extra melee damage
			20% extra true melee damage
			Grants immunity to fire blocks, and temporary immunity to lava
			'''
		Gladiator:
			'''
			+3 defense
			5% increased rogue damage and 10% increased velocity
			Rogue stealth builds while not attacking and not moving, up to a max of 70
			Once you have built max stealth, you will be able to perform a Stealth Strike
			Rogue stealth only reduces when you attack, it does not reduce while moving
			The higher your rogue stealth the higher your rogue damage, crit, and movement speed
			'''
		Obsidian:
			'''
			+2 defense
			5% increased rogue damage and critical strike chance
			Grants immunity to fire blocks and temporary immunity to lava
			Rogue stealth builds while not attacking and not moving, up to a max of 80
			Once you have built max stealth, you will be able to perform a Stealth Strike
			Rogue stealth only reduces when you attack, it does not reduce while moving
			The higher your rogue stealth the higher your rogue damage, crit, and movement speed
			'''
		Eskimo:
			'''
			All ice-themed weapons receive a 10% damage bonus
			Cold enemies will deal reduced contact damage to the player
			Provides immunity to the Frostburn and Glacial State debuffs
			'''
	}

