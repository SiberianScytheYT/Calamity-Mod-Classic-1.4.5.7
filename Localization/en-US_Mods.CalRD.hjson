Configs: {
	CalamityConfig: {
		BossRushXerocCurse: {
			Tooltip:
				'''
				Permanently enrages every boss in the Boss Rush.
				This enrage is equivalent to that provided by Demonshade armor.
				'''
			Label: Xeroc Curse
		}

		BossRushImmunityFrameCurse: {
			Tooltip:
				'''
				During the Boss Rush, being hit twice within three seconds will cause instant death.
				This effect ignores revives.
				'''
			Label: Immunity Frame Curse
		}

		BossRushDashCurse: {
			Tooltip: Disables all dashes during the Boss Rush.
			Label: Dash Curse
		}

		BossRushHealthCurse: {
			Tooltip: Disables all health regeneration during the Boss Rush.
			Label: Health Curse
		}

		BossRushAccessoryCurse: {
			Tooltip: Limits the player to five accessories during the Boss Rush.
			Label: Accessory Curse
		}

		Headers: {
			BossRushCurses: Boss Rush Curses
			RevengeanceModeChanges: Revengeance Mode Changes
			ExpertModeChanges: Expert Mode Changes
			GeneralGameplayChanges: General Gameplay Changes
			UIChanges: UI Changes
			GraphicsChanges: Graphics Changes
		}

		DeathWeatherMultiplier: {
			Tooltip:
				'''
				Adjusts the delay between Death Mode weather hazards such as lightning.
				Decreasing this value makes hazards more frequent.
				Increasing this value makes hazards less frequent.
				'''
			Label: Weather Hazard Delay Multiplier
		}

		AdrenalineMeterPosY: {
			Tooltip:
				'''
				The Y position of the Adrenaline Meter.
				The meter can be dragged with the mouse if Lock Meter Positions is disabled.
				'''
			Label: Adrenaline Meter Y Position
		}

		AdrenalineMeterPosX: {
			Tooltip:
				'''
				The X position of the Adrenaline Meter.
				The meter can be dragged with the mouse if Lock Meter Positions is disabled.
				'''
			Label: Adrenaline Meter X Position
		}

		RageMeterPosY: {
			Tooltip:
				'''
				The Y position of the Rage Meter.
				The meter can be dragged with the mouse if Lock Meter Positions is disabled.
				'''
			Label: Rage Meter Y Position
		}

		RageMeterPosX: {
			Tooltip:
				'''
				The X position of the Rage Meter.
				The meter can be dragged with the mouse if Lock Meter Positions is disabled.
				'''
			Label: Rage Meter X Position
		}

		MeterShake: {
			Tooltip:
				'''
				How much the Rage and Adrenaline Meters shake while in use.
				Set to zero to disable the shaking entirely.
				'''
			Label: Rage and Adrenaline Meter Shake
		}

		Rippers: {
			Tooltip: Enables Rage and Adrenaline, the two Revengeance Mode mechanics.
			Label: Rage and Adrenaline
		}

		DisableExpertTownSpawns: {
			Tooltip:
				'''
				Counteracts Expert Mode allowing enemies to spawn near towns by vastly decreasing spawn rates.
				This can have unintended side effects such as making critters difficult to find.
				'''
			Label: Disable Expert Enemy Spawns in Towns
		}

		NerfExpertPillars: {
			Tooltip:
				'''
				Reduces the kills required to destroy a Celestial Pillar shield in Expert Mode from 150 to 100.
				This makes the value equivalent to Normal Mode.
				'''
			Label: Reduce Celestial Pillar Kill Count
		}

		ReworkChilledWater: {
			Tooltip: When enabled, water in the Snow and Ice biomes will rapidly drain the player's breath instead of inflicting Chilled.
			Label: Rework Chilled Water
		}

		NerfExpertDebuffs: {
			Tooltip:
				'''
				Disables Expert Mode doubling the duration of all debuffs inflicted on the player.
				Calamity is balanced with the assumption that this setting is enabled.
				'''
			Label: Reduce Expert Debuff Durations
		}

		BossHealthBoost: {
			Tooltip:
				'''
				Globally boosts the health of all bosses.
				Does not affect bosses that are already spawned.
				'''
			Label: Boss Health Percentage Boost
		}

		TownNPCSpawnRateMultiplier: {
			Tooltip: Makes town NPCs spawn more quickly, the higher this value is.
			Label: Town NPC Spawn Rate Multiplier
		}

		CanTownNPCsSpawnAtNight: {
			Tooltip: Allows you to determine if town NPCs (including the Old Man) can spawn at night.
			Label: Let Town NPCs spawn at night.
		}

		FullPowerReactiveBossDR: {
			Tooltip:
				'''
				Sets Reactive Boss DR to always be full strength, even if the boss has already been defeated.
				If disabled, the effect is only 66% as powerful after the boss has been defeated.

				Reactive Boss DR makes bosses smoothly take less damage if they are being killed very quickly.
				In most cases, the system has no noticeable effect.
				'''
			Label: Never Weaken Reactive Boss DR
		}

		BossZen: {
			Tooltip: While a boss is alive, all players receive the Boss Zen buff which drastically reduces enemy spawn rates.
			Label: Boss Zen
		}

		MiningSpeedBoost: {
			Tooltip:
				'''
				Increases the player's mining speed by 75%.
				This does not affect drills.
				'''
			Label: Boost Mining Speed
		}

		SellVanillaSummons: {
			Tooltip:
				'''
				Adds vanilla boss summons to NPC shops after the corresponding boss is defeated.
				This does not affect Calamity's boss summons, which are always sold.
				To apply changes, close and reopen the shop.
				'''
			Label: Sell Vanilla Boss Summons
		}

		Proficiency: {
			Tooltip:
				'''
				Enables the Proficiency system which allows the player to gain slight stat bonuses by persistently using one damage class.
				Disabling the system does not remove levels players already have, but disables their stat bonuses and prevents experience gain.
				'''
			Label: Proficiency
		}

		LethalLava: {
			Tooltip:
				'''
				Makes lava significantly more deadly by adding a new debuff.
				Permanent lava immunity does not provide immunity to this debuff.
				This setting is ignored in Death Mode, which always has Lethal Lava.
				'''
			Label: Lethal Lava
		}

		StealthMeterPosY: {
			Tooltip:
				'''
				The Y position of the Stealth Meter.
				The meter can be dragged with the mouse if Lock Meter Positions is disabled.
				'''
			Label: Stealth Meter Y Position
		}

		StealthMeterPosX: {
			Tooltip:
				'''
				The X position of the Stealth Meter.
				The meter can be dragged with the mouse if Lock Meter Positions is disabled.
				'''
			Label: Stealth Meter X Position
		}

		StealthBar: {
			Tooltip:
				'''
				Enables the Stealth Meter UI, which shows the player's current stealth level.
				The Stealth Meter is always hidden if not wearing Rogue armor.
				'''
			Label: Stealth Meter
		}

		MeterPosLock: {
			Tooltip:
				'''
				Prevents clicking on the Stealth, Rage and Adrenaline Meters.
				This stops them from being dragged around with the mouse.
				'''
			Label: Lock Meter Positions
		}

		DebuffDisplay: {
			Tooltip: Adds an array of debuff icons above all bosses and minibosses.
			Label: Boss and Miniboss Debuff Display
		}

		BossHealthBarExtraInfo: {
			Tooltip:
				'''
				Adds extra info to the Calamity boss health bar.
				This displays either the boss's exact health or number of remaining parts or segments.
				'''
			Label: Boss Health Bar Extra Info
		}

		BossHealthBar: {
			Tooltip: Enables Calamity's boss health bar in the bottom right corner of the screen.
			Label: Boss Health Bars
		}

		ShopNewAlert: {
			Tooltip: Adds an icon that appears over Town NPCs when they have new items in their shops.
			Label: New Shop Inventory Alert
		}

		StealthInvisbility: {
			Tooltip:
				'''
				Enables players gradually turning invisible as their Rogue Stealth increases.
				This effect is visually similar to Shroomite armor's stealth.
				'''
			Label: Stealth Invisibility
		}

		Afterimages: {
			Tooltip:
				'''
				Enables rendering afterimages for Calamity NPCs, projectiles, etc.
				Disable to improve performance.
				'''
			Label: Afterimages
		}

		DisplayName: Config
	}
}

